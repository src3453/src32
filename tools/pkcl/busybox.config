# Options applied on top of BusyBox's `allnoconfig` (doc/spec_pkcl.md §8).
# One CONFIG_NAME=y|n|"string" per line. BusyBox itself (GPL-2.0) is never
# part of this repository: tools/pkcl/busybox.py takes a source tree you
# fetched yourself.
CONFIG_NOMMU=y
CONFIG_LFS=n
CONFIG_STATIC=y
CONFIG_SHOW_USAGE=y
CONFIG_BUSYBOX=y
CONFIG_FEATURE_INSTALLER=n
CONFIG_CAT=y
CONFIG_ECHO=y
CONFIG_TRUE=y
CONFIG_FALSE=y
CONFIG_PWD=y
CONFIG_BASENAME=y
CONFIG_DIRNAME=y
CONFIG_HEAD=y
CONFIG_WC=y
CONFIG_MKDIR=y
CONFIG_RMDIR=y
CONFIG_RM=y
CONFIG_CP=y
CONFIG_MV=y
CONFIG_LS=y
CONFIG_SLEEP=y
CONFIG_TEST=y
CONFIG_PRINTF=y
