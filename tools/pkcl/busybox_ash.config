# BusyBox の MMU 構成（fork を使う）と ash。busybox.config の後に重ねる（doc/spec_pkcl.md §8.3）。
# Foundation の VM バックエンドで動く。slot／nommu のバックエンドには fork がない。
CONFIG_NOMMU=n
CONFIG_SH_IS_ASH=y
CONFIG_SH_IS_NONE=n
CONFIG_SHELL_ASH=y
CONFIG_ASH=y
CONFIG_ASH_OPTIMIZE_FOR_SIZE=y
CONFIG_FEATURE_SH_STANDALONE=y
CONFIG_FEATURE_PREFER_APPLETS=y
# applet を exec し直すときの実行形式。WAX を拡張子なしでも置く（/bin/busybox）。
CONFIG_BUSYBOX_EXEC_PATH="/bin/busybox"
CONFIG_WC=y
CONFIG_ENV=y
