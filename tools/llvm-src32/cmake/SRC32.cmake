# SRC32 source-library and executable targets. Requires CMake 3.20+.
include_guard(GLOBAL)
include(CMakeParseArguments)

set(SRC32_PYTHON_EXECUTABLE "" CACHE FILEPATH "Python interpreter with llvmlite installed")
set(SRC32_CLANG "" CACHE FILEPATH "Clang executable (empty: driver discovery)")

function(_src32_collect_library target trail out_sources out_includes out_definitions)
    if(NOT TARGET "${target}")
        message(FATAL_ERROR "Unknown SRC32 library: ${target}")
    endif()
    if("${target}" IN_LIST trail)
        message(FATAL_ERROR "Cyclic SRC32 source-library dependency: ${trail};${target}")
    endif()
    get_target_property(is_src32 "${target}" SRC32_SOURCE_LIBRARY)
    if(NOT is_src32)
        message(FATAL_ERROR "${target} is not a src32_add_library target")
    endif()
    list(APPEND trail "${target}")
    get_target_property(sources "${target}" SRC32_SOURCES)
    get_target_property(includes "${target}" SRC32_INCLUDES)
    get_target_property(definitions "${target}" SRC32_DEFINITIONS)
    get_target_property(libraries "${target}" SRC32_LIBRARIES)
    foreach(property sources includes definitions libraries)
        if("${${property}}" MATCHES "-NOTFOUND$")
            set(${property} "")
        endif()
    endforeach()
    foreach(library IN LISTS libraries)
        _src32_collect_library("${library}" "${trail}" child_sources child_includes child_definitions)
        list(APPEND sources ${child_sources})
        list(APPEND includes ${child_includes})
        list(APPEND definitions ${child_definitions})
    endforeach()
    set(${out_sources} "${sources}" PARENT_SCOPE)
    set(${out_includes} "${includes}" PARENT_SCOPE)
    set(${out_definitions} "${definitions}" PARENT_SCOPE)
endfunction()

function(_src32_absolute input output)
    set(result "")
    foreach(path IN LISTS ${input})
        get_filename_component(absolute "${path}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
        list(APPEND result "${absolute}")
    endforeach()
    set(${output} "${result}" PARENT_SCOPE)
endfunction()

function(src32_add_library name)
    cmake_parse_arguments(ARG "" "" "SOURCES;INCLUDE_DIRECTORIES;DEFINITIONS;LIBRARIES" ${ARGN})
    if(ARG_UNPARSED_ARGUMENTS OR ARG_KEYWORDS_MISSING_VALUES)
        message(FATAL_ERROR "Invalid src32_add_library arguments: ${ARG_UNPARSED_ARGUMENTS};${ARG_KEYWORDS_MISSING_VALUES}")
    endif()
    _src32_absolute(ARG_SOURCES sources)
    _src32_absolute(ARG_INCLUDE_DIRECTORIES includes)
    add_library("${name}" INTERFACE)
    set_target_properties("${name}" PROPERTIES SRC32_SOURCE_LIBRARY TRUE
        SRC32_SOURCES "${sources}" SRC32_INCLUDES "${includes}"
        SRC32_DEFINITIONS "${ARG_DEFINITIONS}" SRC32_LIBRARIES "${ARG_LIBRARIES}")
endfunction()

function(src32_add_executable name)
    cmake_parse_arguments(ARG "" "OPTIMIZATION;ORIGIN;STACK_TOP;ENTRY"
        "SOURCES;INCLUDE_DIRECTORIES;DEFINITIONS;LIBRARIES" ${ARGN})
    if(ARG_UNPARSED_ARGUMENTS OR ARG_KEYWORDS_MISSING_VALUES)
        message(FATAL_ERROR "Invalid src32_add_executable arguments: ${ARG_UNPARSED_ARGUMENTS};${ARG_KEYWORDS_MISSING_VALUES}")
    endif()
    if(NOT SRC32_PYTHON_EXECUTABLE)
        find_package(Python3 3.11 REQUIRED COMPONENTS Interpreter)
        set(SRC32_PYTHON_EXECUTABLE "${Python3_EXECUTABLE}")
    endif()
    execute_process(COMMAND "${SRC32_PYTHON_EXECUTABLE}" -c "import llvmlite.binding"
        RESULT_VARIABLE dependency_result ERROR_VARIABLE dependency_error)
    if(NOT dependency_result EQUAL 0)
        message(FATAL_ERROR "SRC32_PYTHON_EXECUTABLE needs llvmlite: ${dependency_error}")
    endif()
    _src32_absolute(ARG_SOURCES sources)
    _src32_absolute(ARG_INCLUDE_DIRECTORIES includes)
    set(definitions ${ARG_DEFINITIONS})
    foreach(library IN LISTS ARG_LIBRARIES)
        _src32_collect_library("${library}" "" child_sources child_includes child_definitions)
        list(APPEND sources ${child_sources})
        list(APPEND includes ${child_includes})
        list(APPEND definitions ${child_definitions})
    endforeach()
    if(NOT sources)
        message(FATAL_ERROR "src32_add_executable(${name}) has no sources")
    endif()
    list(REMOVE_DUPLICATES sources)
    list(REMOVE_DUPLICATES includes)
    list(REMOVE_DUPLICATES definitions)
    set(arguments "")
    foreach(include IN LISTS includes)
        list(APPEND arguments -I "${include}")
    endforeach()
    foreach(definition IN LISTS definitions)
        list(APPEND arguments "-D${definition}")
    endforeach()
    if(SRC32_CLANG)
        list(APPEND arguments --clang "${SRC32_CLANG}")
    endif()
    if(NOT DEFINED ARG_OPTIMIZATION)
        set(ARG_OPTIMIZATION 0)
    endif()
    if(NOT ARG_OPTIMIZATION MATCHES "^[012]$")
        message(FATAL_ERROR "OPTIMIZATION must be 0, 1 or 2")
    endif()
    list(APPEND arguments "-O${ARG_OPTIMIZATION}")
    foreach(option ORIGIN STACK_TOP ENTRY)
        if(DEFINED ARG_${option})
            string(TOLOWER "${option}" flag)
            string(REPLACE "_" "-" flag "${flag}")
            list(APPEND arguments "--${flag}" "${ARG_${option}}")
        endif()
    endforeach()
    get_filename_component(tool_root "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/.." ABSOLUTE)
    set(image "${CMAKE_CURRENT_BINARY_DIR}/${name}.wax")
    set(depfile "${CMAKE_CURRENT_BINARY_DIR}/${name}.d")
    file(GLOB_RECURSE compiler_dependencies CONFIGURE_DEPENDS
        "${tool_root}/*.py" "${tool_root}/runtime/*.c" "${tool_root}/runtime/include/*.h")
    add_custom_command(OUTPUT "${image}"
        COMMAND "${SRC32_PYTHON_EXECUTABLE}" "${tool_root}/driver.py"
            ${sources} ${arguments} --depfile "${depfile}" -o "${image}"
        DEPENDS ${sources} ${compiler_dependencies}
            "${tool_root}/../asm/asm.py" "${tool_root}/../wax/wax.py"
        DEPFILE "${depfile}"
        COMMENT "Compiling freestanding C/C++ target ${name} for SRC32"
        VERBATIM COMMAND_EXPAND_LISTS)
    add_custom_target("${name}" ALL DEPENDS "${image}")
    set_target_properties("${name}" PROPERTIES SRC32_IMAGE "${image}")
endfunction()
