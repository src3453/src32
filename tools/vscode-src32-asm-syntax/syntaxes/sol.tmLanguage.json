{
  "name": "sol",
  "scopeName": "source.sol",
  "patterns": [
    { "include": "#comments" },
    { "include": "#directives" },
    { "include": "#asm-block" },
    { "include": "#label-definition" },
    { "include": "#label-reference" },
    { "include": "#function" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#store" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.sol",
          "match": "#.*$"
        }
      ]
    },
    "directives": {
      "patterns": [
        {
          "name": "keyword.control.directive.sol",
          "match": "(?i)\\!\\b(include|define|undef|const|var|end|required_stack_size|required_return_stack_size|force_stack_size|force_return_stack_size|asm)\\b"
        },
        {
          "name": "string.quoted.double.include.sol",
          "begin": "(?i)\\!include\\s+\"",
          "beginCaptures": { "0": { "name": "keyword.control.directive.sol" } },
          "end": "\"",
          "patterns": [
            { "name": "string.quoted.double.sol", "match": "[^"]+" }
          ]
        }
      ]
    },
    "asm-block": {
      "patterns": [
        {
          "name": "meta.directive.asm.sol",
          "begin": "(?i)^\\s*\\!asm\\b",
          "beginCaptures": { "0": { "name": "keyword.control.directive.sol" } },
          "end": "(?i)^\\s*\\!end\\b",
          "endCaptures": { "0": { "name": "keyword.control.directive.sol" } },
          "patterns": [
            { "include": "source.src32asm" }
          ]
        }
      ]
    },
    "label-definition": {
      "patterns": [
        {
          "name": "entity.name.label.sol",
          "match": "^\\s*@(?!\\d)([A-Za-z_][A-Za-z0-9_]*)\\b"
        }
      ]
    },
    "label-reference": {
      "patterns": [
        {
          "name": "entity.other.reference.label.sol",
          "match": "\\B@(?!\\d)([A-Za-z_][A-Za-z0-9_]*)\\b"
        }
      ]
    },
    "function": {
      "patterns": [
        {
          "name": "entity.name.function.sol",
          "match": "\\bfn\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*\\([^\)]*\\)\\s*:\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.sol",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.sol", "match": "\\\\." }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.hex.sol", "match": "\\b-?0x[0-9A-Fa-f]+u?\\b" },
        { "name": "constant.numeric.decimal.unsigned.sol", "match": "\\b-?[0-9]+u\\b" },
        { "name": "constant.numeric.decimal.sol", "match": "\\b-?[0-9]+\\b" }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arithmetic.sol",
          "match": "\\b(add|sub|mul|div|mod|neg)\\b"
        },
        {
          "name": "keyword.operator.bitwise.sol",
          "match": "\\b(and|or|xor|not|shl|shr)\\b"
        },
        {
          "name": "keyword.operator.stack.sol",
          "match": "\\b(dup|drop|swap|over|rot|nip|tuck)\\b"
        },
        {
          "name": "keyword.operator.comparison.sol",
          "match": "\\b(eq|neq|lt|gt|le|ge|sgn)\\b"
        },
        {
          "name": "keyword.operator.mem.sol",
          "match": "\\b(ld|st|ldb|stb|ldh|sth)\\b"
        },
        {
          "name": "keyword.operator.return-stack.sol",
          "match": "\\b(rpush|rpop|rpeek)\\b"
        },
        {
          "name": "keyword.operator.control.sol",
          "match": "\\b(jmp|jz|jnz|ret|fn)\\b"
        },
        {
          "name": "keyword.operator.io.sol",
          "match": "\\b(prn|prnln|putc|strlen|tostr|tohex|tobin)\\b"
        },
        {
          "name": "keyword.other.sol",
          "match": "\\b(stacksize|retsize|halt)\\b"
        }
      ]
    },
    "store": {
      "patterns": [
        { "name": "keyword.operator.store.sol", "match": ">(?=[A-Za-z_][A-Za-z0-9_]*)" },
        { "name": "keyword.operator.store.prefix.sol", "match": ">" }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.sol",
          "match": "\\b(?![0-9])[A-Za-z_][A-Za-z0-9_]*\\b"
        }
      ]
    }
  }
}
