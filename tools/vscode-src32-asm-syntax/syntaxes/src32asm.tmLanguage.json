{
  "name": "SRC32 Assembly",
  "scopeName": "source.src32asm",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#label-definition"
    },
    {
      "include": "#directives"
    },
    {
      "include": "#opcodes"
    },
    {
      "include": "#registers"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#memory-brackets"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.semicolon.src32asm",
          "match": ";.*$"
        }
      ]
    },
    "label-definition": {
      "patterns": [
        {
          "name": "entity.name.function.label.src32asm",
          "match": "^\\s*([A-Za-z_.$][\\w.$]*)\\s*:"
        }
      ]
    },
    "directives": {
      "patterns": [
        {
          "name": "keyword.control.directive.src32asm",
          "match": "(?i)\\.(ORG|WORD|BYTE|DB|STRING|DEFINE|ENDDEF|INCLUDE|CONST)"
        },
        {
          "name": "keyword.control.asmprefix.src32asm",
          "match": "(?i)\\b(R|A)\\!\\b"
        }
      ]
    },
    "opcodes": {
      "patterns": [
        {
          "name": "keyword.instruction.src32asm",
          "match": "(?i)\\b(NOP|LD|ST|ADD|ADDI|SUB|SLT|BEQ|BNE|JMP|JAL|JR|AND|OR|XOR|SLL|SRL|SLA|SRA|LDB|LDH|STB|STH|CPUID|HALT|LDIH|LDIL|SLTU|MUL|DIV|MOD|MULH|DIVU|JMPS|JALS|JRS)\\b"
        },
        {
          "name": "keyword.instruction_short.src32asm",
          "match": "(?i)\\bS\\.(MOV|ADD|ADDI|LD|ST|BZ|BNZ|JR|LDI|RET)\\b"
        }
      ]
    },
    "registers": {
      "patterns": [
        {
          "name": "variable.language.register.src32asm",
          "match": "(?i)\\b(R(?:3[0-1]|[1-2][0-9]|[0-9]))\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.src32asm",
          "match": "(?i)\\b-?0x[0-9a-f]+\\b"
        },
        {
          "name": "constant.numeric.binary.src32asm",
          "match": "(?i)\\b-?0b[01]+\\b"
        },
        {
          "name": "constant.numeric.decimal.src32asm",
          "match": "\\b-?[0-9]+\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.src32asm",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.src32asm",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "memory-brackets": {
      "patterns": [
        {
          "name": "meta.brackets.memory.src32asm",
          "match": "[\\[\\]]"
        }
      ]
    }
  }
}