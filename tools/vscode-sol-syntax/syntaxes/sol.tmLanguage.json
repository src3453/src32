{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "sol",
	"scopeName": "source.sol",
	"patterns": [
		{
			"include": "#comments"
		},
		{
			"include": "#asm"
		},
		{
			"include": "#directives"
		},
		{
			"include": "#declarations"
		},
		{
			"include": "#labels"
		},
		{
			"include": "#operators"
		},
		{
			"include": "#controlKeywords"
		},
		{
			"include": "#numbers"
		},
		{
			"include": "#strings"
		},
		{
			"include": "#variables"
		},
		{
			"include": "#identifiers"
		},
		{
			"include": "#type"
		}
	],
	"repository": {
		"comments": {
			"patterns": [{
				"name": "comment.line.number-sign.sol",
				"match": "#.*$"
			}]
		},
		"asm": {
			"patterns": [{
				"name": "meta.embedded.block.asm.sol",
				"begin": "^\\s*!asm\\b",
				"beginCaptures": {
					"0": {
						"name": "keyword.directive.sol"
					}
				},
				"end": "^\\s*!end\\b",
				"endCaptures": {
					"0": {
						"name": "keyword.directive.sol"
					}
				},
				"patterns": [{
					"name": "comment.line.semicolon.asm",
					"match": ";.*$"
				}, {
					"name": "string.quoted.double.asm",
					"begin": "\"",
					"end": "\"",
					"patterns": [{
						"name": "constant.character.escape.asm",
						"match": "\\\\."
					}]
				}, {
					"name": "constant.numeric.binary.asm",
					"match": "\\b-?0b[01]+\\b"
				}, {
					"name": "constant.numeric.hex.asm",
					"match": "\\b-?0x[0-9A-Fa-f]+\\b"
				}, {
					"name": "constant.numeric.integer.asm",
					"match": "\\b-?\\d+\\b"
				}, {
					"name": "entity.name.label.asm",
					"match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
				}]
			}]
		},
		"directives": {
			"patterns": [{
				"name": "meta.directive.sol",
				"match": "^(\\s*)(!(?:include|define|undef|const|var|end|required_stack_size|required_return_stack_size|force_stack_size|force_return_stack_size|asm|data|db)\\b)(?:\\s+([A-Za-z_][A-Za-z0-9_]*))?",
				"captures": {
					"2": {
						"name": "keyword.control.directive.c"
					},
					"3": {
						"name": "entity.name.variable.sol"
					}
				}
			}]
		},
		"declarations": {
			"patterns": [{
				"name": "meta.function.declaration.sol",
				"match": "\\bfn\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*\\(([^)]*)\\)\\s*:?",
				"captures": {
					"0": {
						"name": "storage.type.function.sol"
					},
					"1": {
						"name": "entity.name.function.sol"
					},
					"2": {
						"name": "variable.parameter.sol"
					}
				}
			}, {
				"name": "meta.variable.declaration.sol",
				"match": "(?:^|\\s)(?:!var|!const|local)\\s+([A-Za-z_][A-Za-z0-9_]*)",
				"captures": {
					"0": {
						"name": "storage.type.variable.sol"
					},
					"1": {
						"name": "entity.name.variable.sol"
					}
				}
			}, {
				"name": "meta.constant.declaration.sol",
				"match": "(?:^|\\s)!define\\s+([A-Za-z_][A-Za-z0-9_]*)",
				"captures": {
					"0": {
						"name": "storage.type.constant.sol"
					},
					"1": {
						"name": "entity.name.constant.sol"
					}
				}
			}]
		},
		"controlKeywords": {
			"patterns": [{
				"name": "storage.type.function.sol",
				"match": "\\b(?:if|while|else|end)\\b"
			}]
		},
		"operators": {
			"patterns": [{
				"name": "variable.other.readwrite.c",
				"match": "\\b(add|sub|mul|div|mod|neg|and|or|xor|not|shl|shr|dup|drop|swap|over|rot|nip|tuck|eq|neq|lt|gt|le|ge|sgn|ld|st|ldb|stb|ldh|sth|stacksize|halt|ret|retn)\\b"
			}]
		},
		"numbers": {
			"patterns": [{
				"name": "constant.numeric.binary.sol",
				"match": "\\b-?0b[01]+\\b"
			}, {
				"name": "constant.numeric.hex.sol",
				"match": "\\b-?0x[0-9A-Fa-f]+\\b"
			}, {
				"name": "constant.numeric.integer.sol",
				"match": "\\b-?\\d+u?\\b"
			}]
		},
		"strings": {
			"patterns": [{
				"name": "string.quoted.double.sol",
				"begin": "\"",
				"end": "\"",
				"patterns": [
					{
						"name": "constant.character.escape.sol",
						"match": "\\\\."
					}
				]
			}]
		},
		"type": {
			"patterns": [{
				"name": "entity.name.type.sol",
				"match": "(>|\\$|%|&|~)"
			}]
		}
	},
	"foldingStartMarker": "^\\s*!(?:asm|if|while|for|fn)\\b",
	"foldingStopMarker": "^\\s*!end\\b|^\\s*;\\s*$"
}