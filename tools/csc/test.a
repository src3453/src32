.ORG 0x00000000
start:
    LDI R28, 0x0000FFFC    ; init SP
    LDI R30, vars          ; GP -> vars base
    JAL bc_2
    HALT
bc_0: ; CALL main
    JAL bc_2
    ADDI R28, R28, -4
    ST R1, [R28 + 0]
bc_1: ; HALT
    HALT
bc_2: ; PUSH_CONST 1
    LDI R1, 1
    ADDI R28, R28, -4
    ST R1, [R28 + 0]
bc_3: ; PUSH_CONST 2
    LDI R1, 2
    ADDI R28, R28, -4
    ST R1, [R28 + 0]
bc_4: ; ADD
    LD R2, [R28 + 0]
    ADDI R28, R28, 4
    LD R1, [R28 + 0]
    ADDI R28, R28, 4
    ADD R1, R1, R2
    ADDI R28, R28, -4
    ST R1, [R28 + 0]
bc_5: ; PUSH_CONST 3
    LDI R1, 3
    ADDI R28, R28, -4
    ST R1, [R28 + 0]
bc_6: ; CMP ==
    LD R2, [R28 + 0]
    ADDI R28, R28, 4
    LD R1, [R28 + 0]
    ADDI R28, R28, 4
    BEQ R1, R2, cmp_true_6
    LDI R1, 0
    JMP cmp_end_6
cmp_true_6:
    LDI R1, 1
cmp_end_6:
    ADDI R28, R28, -4
    ST R1, [R28 + 0]
bc_7: ; JUMP_IF_FALSE 11
    LD R1, [R28 + 0]
    ADDI R28, R28, 4
    BEQ R1, R0, bc_11
bc_8: ; PUSH_CONST 0
    LDI R1, 0
    ADDI R28, R28, -4
    ST R1, [R28 + 0]
bc_9: ; RETURN
    LD R1, [R28 + 0]
    ADDI R28, R28, 4
    JR R31
bc_10: ; JUMP 13
    JMP bc_13
bc_11: ; PUSH_CONST 1
    LDI R1, 1
    ADDI R28, R28, -4
    ST R1, [R28 + 0]
bc_12: ; RETURN
    LD R1, [R28 + 0]
    ADDI R28, R28, 4
    JR R31
bc_13: ; PUSH_CONST 0
    LDI R1, 0
    ADDI R28, R28, -4
    ST R1, [R28 + 0]
bc_14: ; RETURN
    LD R1, [R28 + 0]
    ADDI R28, R28, 4
    JR R31

; data section
.ORG 0x00008000
vars: