LDI R1, 0x10000000
LDI R2, 0x10012C00
LDI R3, 1
LDI R4, 1
LDI R5, 1
LDI R6, 0

loop:
    STB R4, [R1] ; New instruction: STB (store byte, SRC32-L Extension) - Store the least significant byte of R4 into memory at address R1
    ADD R4, R5, R4
    ADD R5, R4, R5
    ;SRA R4, R4, R3
    ADD R1, R1, R3
    BNE R1, R2, loop
    
LDI R1, 0x10000000
ADD R6, R6, R5
ADD R4, R6, R0
JMP loop

