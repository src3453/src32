; Report CPUID Extension V as a single PCG character, with R1=42 on success.
; Run on the same CPU engine as the shell; no Foundation kernel is involved.
.ORG 0
    CPUID
    NOP
    NOP
    NOP
    LDIL R3, 0x0200
    AND R2, R2, R3
    SLTU R2, R0, R2
    ADDI R2, R2, 48
    LDIH R3, 0x1000
    LDIL R3, 0
    STB [R3+0], R2
    ADDI R1, R0, 42
    HALT
