; Foundation stage1 boot sector (doc/spec_Foundation.md §11, doc/spec_FS2.md §3).
;
; The BIOS loads this block to 0x00000000 and enters it in S mode with
; R1 = boot drive and IRQs off (doc/spec_BIOS.md §3). stage1 checks the FS2
; superblock, reads FNDBOOT from the reserved boot area to 0x00200000, checks
; its header, copies the kernel to kernel_load and jumps to kernel_entry with
; R1 = drive and R2 = 0x00200000.
;
; On failure it HALTs with IRQs still off and R1 = the failed step:
;   1 IDENTIFY or superblock read, 2 superblock check,
;   3 FNDBOOT read or header check.
;
; Build: python tools/asm/asm.py -o stage1.bin foundation/boot/stage1.a

.CONST SUPERBLOCK 0x200        ; LBA 1 is read here, inside the reserved 0x0-0xFFFF
.CONST STAGING_HI 0x0020       ; 0x00200000, also the 2 MiB FNDBOOT limit
.CONST IDC_HI 0x8004
.CONST IDC_LO 0x1000
.CONST DMAC_HI 0x8005
.CONST KERNEL_MAX_HI 0x000E    ; 0x000E0000 bytes up to the kernel stack

; R20 drive, R21 IDC, R22 DMAC, R24 staging, R9 = 9, R25 = 0x10000
    ADD R20, R1, R0
    LDIH R21, IDC_HI
    LDIL R21, IDC_LO
    LDIH R22, DMAC_HI
    LDIL R22, 0
    LDIH R24, STAGING_HI
    LDIL R24, 0
    ADDI R9, R0, 9
    LDIH R25, 0x0001           ; 0x00010000: FS2 version word and kernel_load
    LDIL R25, 0

    ADDI R1, R0, 1             ; IDENTIFY -> R10 = capacity
    JAL idc_begin
    ADDI R6, R0, 3
    ST [R21+0x18], R6
    JAL idc_end
    LD R10, [R21+0x30]

    ADDI R3, R0, 1             ; superblock (LBA 1) -> R5
    ADDI R4, R0, 1
    ADDI R5, R0, SUPERBLOCK
    JAL read

    ADDI R1, R0, 2             ; FS2 §3: magic, version 1 with flags 0 (DIRTY=0)
    LD R6, [R5+0]
    LDIH R7, 0x4653
    LDIL R7, 0x3200
    BNE R6, R7, fail
    LD R6, [R5+4]
    BNE R6, R25, fail
    LD R11, [R5+0x08]          ; total_blocks <= capacity
    SLTU R6, R10, R11
    BNE R6, R0, fail
    LD R6, [R5+0x0C]           ; boot_start = 2
    ADDI R7, R0, 2
    BNE R6, R7, fail
    LD R12, [R5+0x10]          ; bitmap_start = 2 + boot_blocks without wrapping,
    LD R13, [R5+0x18]          ; and bitmap_start <= data_start <= total_blocks
    ADD R6, R12, R7
    BNE R6, R13, fail
    SLTU R6, R13, R7
    BNE R6, R0, fail
    LD R6, [R5+0x2C]
    SLTU R7, R6, R13
    BNE R7, R0, fail
    SLTU R7, R11, R6
    BNE R7, R0, fail
    LD R18, [R5+0x14]          ; 0 < boot_size <= 2 MiB, ceil(boot_size/512) <= boot_blocks
    BEQ R18, R0, fail
    SLTU R6, R24, R18
    BNE R6, R0, fail
    ADDI R4, R18, 511
    SRL R4, R4, R9
    SLTU R6, R12, R4
    BNE R6, R0, fail

    ADDI R1, R0, 3             ; FNDBOOT: R4 sectors from LBA 2 to staging
    ADDI R3, R0, 2
    ADD R5, R24, R0
    JAL read

    LD R6, [R24+0]             ; Foundation §11 header
    LDIH R7, 0x464E            ; "FNDB"
    LDIL R7, 0x4442
    BNE R6, R7, fail
    LD R6, [R24+4]             ; version 1
    ADDI R7, R0, 1
    BNE R6, R7, fail
    LD R6, [R24+8]             ; size = boot_size
    BNE R6, R18, fail
    LD R3, [R24+12]            ; kernel_off + kernel_size <= size
    LD R4, [R24+16]
    LD R5, [R24+20]
    LD R8, [R24+24]
    SLTU R7, R18, R3
    BNE R7, R0, fail
    SUB R6, R18, R3
    SLTU R7, R6, R4
    BNE R7, R0, fail
    BNE R5, R25, fail          ; kernel_load = 0x00010000
    LDIH R7, KERNEL_MAX_HI     ; kernel_size <= 0xE0000
    LDIL R7, 0
    SLTU R7, R7, R4
    BNE R7, R0, fail
    SUB R6, R8, R5             ; kernel_load <= kernel_entry < kernel_load + kernel_size
    SLTU R7, R6, R4
    BEQ R7, R0, fail

    ADD R3, R3, R24            ; copy the kernel
    ADD R4, R4, R5
copy:
    BEQ R5, R4, enter
    LDB R6, [R3+0]
    STB [R5+0], R6
    ADDI R3, R3, 1
    ADDI R5, R5, 1
    JMP copy
enter:
    ADD R1, R20, R0
    ADD R2, R24, R0
    JR R8

fail:
    HALT
    JMP fail

; R3 = LBA, R4 = sectors, R5 = RAM destination (sdk/cpt32/src/idc.c idc_read)
read:
    ADD R19, R31, R0
    JAL idc_begin
    ST [R21+0x1C], R3
    ST [R21+0x20], R4
    ADDI R6, R21, 0x24         ; IDC DATA endpoint
    ST [R22+0x100], R6
    ST [R22+0x104], R5
    SLL R6, R4, R9
    ST [R22+0x108], R6
    ADDI R6, R0, 1
    ST [R21+0x18], R6          ; READ
    ADDI R6, R0, 0x104
    ST [R22+0x10C], R6         ; DMAC ch0: fixed source, incrementing RAM, 8-bit
    JAL idc_end
    JR R19

; Clears the sticky DONE/ERROR bits and selects the drive. The BIOS read
; this block through DMAC ch0, so the DMAC and ch0 are already enabled.
idc_begin:
    ADDI R6, R0, 6
    ST [R22+0x110], R6
    ST [R21+8], R6
    ST [R21+0x14], R20
    JR R31

; Waits for DMAC ch0 and the IDC, then fails on IDC ERROR, which also
; reports DMA failures (doc/spec_IDC.md §5).
idc_end:
    ADDI R7, R0, 1
dma_wait:
    LD R6, [R22+0x110]
    AND R6, R6, R7
    BNE R6, R0, dma_wait
idc_wait:
    LD R6, [R21+8]
    AND R6, R6, R7
    BNE R6, R0, idc_wait
    LD R6, [R21+8]
    ADDI R7, R0, 4
    AND R6, R6, R7
    BNE R6, R0, fail
    JR R31

.ORG 0x1FE
.BYTE 0x55
.BYTE 0xAA
